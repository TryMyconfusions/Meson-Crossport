
//THIS PROJECT IS LARGELY BASED OF MESONS DOCUMENTATION ABOUT CROSS COMPILATION!!
//CrossPort

//crossport simplifies making cross compiled binaries from meson by generating crossfiles for meson build system!





import std.getopt;
import std.stdio;
import std.file;

import std.uni;
import std.bitmanip;
import std.conv;

import std.algorithm.searching;
import std.json;
import crosslib;


import conflib;























void main(string[] args) 
{
	

	try 
	{
	// this extracts the required arrays i need for this project.
	// I added the arrays in the json because it looked cleaner.
	JSONValue arrays = std.json.parseJSON(jsonstuff);

	conflib.cpu_family = arrays["architectures"].array();
	conflib.supported_os = arrays["supportedOS"].array();
	conflib.endians = arrays["endians"].array();

	} 

	catch (Exception e)  // give a clean error of why it failed!
	{
		writeln(e.msg);
		writeln(jsonstuff); 
		return;
	}
	try {
	

		// This is the function containing every single command in this software.

	auto crossarg = getopt( // this is where the commandline parsing is made same approach as C getopt
		args,
		"v|verbose", "mainly for debugging purposes, tells the user what the program is doing", &conflib.verbose,
		"arch|a", "Cpu architecture", &conflib.cpufamily,
		"platform|p", "Targeted OS to export to", &conflib.target_os,
		"endian|e","the direction cpu reads big reads from left to right while little reads from right to left", &endian,
 
		"d", "D Compiler Path", &conflib.d_compiler,
		"c", "C Compiler Path", &conflib.c_compiler,
		"cpp","C++ Compiler", &conflib.cpp_compiler,
		"cs", "C# Compiler", &conflib.cs_compiler,
		"rust", "Rust Compiler", &conflib.rust_compiler,
		"fortran", "Fortran Compiler", &conflib.fortran_compiler,

		"ar", "Ar Path", &conflib.ar,
		"strip|s", "strip Path", &conflib.strip,
		"exe", "exe wrapper Path", &conflib.exe_wrapper,
		"windres|w", "windres Path", &conflib.windres,
		

		"soi", "[advanced] sizeof_int", &conflib.soi,
		"soc", "[advanced] sizeof_wchar_t", &conflib.soc,
		"sov", "[advanced] sizeof_void*", &conflib.sov,

		"alc", "[advanced] alignment_char", &conflib.alc,
		"alv", "[advanced] alignment_void*", &conflib.alv,
		"ald", "[advanced] alignment_double", &conflib.ald,

		"hfpf", "[advanced] has_function_printf", &conflib.has_printf,
		"sysroot", "[advanced] system root path", &conflib.sys_root,
		"pkgconf", "[advanced] pkg_config_libdir path", &conflib.pkg_conf,
		"needwrapper", "need exe wrapper", &conflib.needs_exe_wrap,

		"da", "D arguments", &conflib.da,
		"ca", "C arguments", &conflib.ca,
		"cppa", "C++ arguments", &conflib.cppa,

		"dla", "D Link arguments", &conflib.dla,
		"cla", "C Link arguments", &conflib.cla,
		"cppla", "C++ Link arguments", &conflib.cppla,
		"fixpath", "the path with the broken build.ninja", &conflib.fixpath,

		"csl", "[advanced] c_std_lib", &cstdlib,
		"cppsl", "[advanced] cpp_std_lib", &cppstdlib

	);

	printv("created getopt" );
	

	if (crossarg.helpWanted) 
	{
		//Basic help commands
		defaultGetoptPrinter("here are the commands for crossport", crossarg.options);
		return;
	}

	// Fixpath fixes -L=-L= to -L= because meson wants to be helpful by adding a extra -L=, when i was testing Crossport meson was adding a Extra -L=
	// and when i remove it, well meson just doesnt add it so thats why i made fixpath.
	
	if (conflib.fixpath != "")
	{
		try {

		writeln("Fixing Build.ninja...");

		string buildninja = std.file.readText(conflib.fixpath);
		if (buildninja.canFind("-L=-L=")) {
			string fixedcontents = crosslib.fix_build_ninja(buildninja); //fix the build.ninja
			std.file.write(conflib.fixpath,fixedcontents);  // write the fix into the file
			writeln("Sucessfully fixed build.ninja"); // tell the user it is sucessful
		}
		else 
		{
			writeln("Could not find -L=-L= Pattern");
		}
		}
		catch (Exception e) 
		{
			writeln("couldnt write file or path is invalid!");
			printv("PATH: " ~ conflib.fixpath);
		}

		return; //prevent it from causing any errors because fixpath is meant to be run by itself
	}


	add_obj("#auto-generated by Crossport"); // this is a watermark just to notify the user

	add_obj(""); // add a new line because generate crossfile auto adds a newline

	//add_obj("[host_machine]");




	printv("added stuffforfile [host_machine]" );

	// Host Machine


	if (find_e(cpufamily,cpu_family) != "")  // cpu architecture
	{ 
		add_section("[host_machine]", conflib.required_sections.hostmachine);


		add_obj("cpu_family = '" ~ cpufamily ~ "'");
		add_obj("cpu = '" ~ cpufamily ~ "'");

		passedflag();

		writeln("sucessfully added architecture!");
		printv("added architecture: " ~ cpufamily);
	} 

	else 

	{
		writeln("architecture not supported! run crossport with -h flag for help!");
		return; //return to prevent code from running underneath!
	}


	// TargetOS just tells meson where to export the app.

	if (find_e(target_os,supported_os) != "") // target OS
	{ 
		add_section("[host_machine]", conflib.required_sections.hostmachine);

	    // if the OS is os/2 there are technical problems with it like spitting out OS\/2 so i
		// turned the name into os2 to prevent it.

		if (target_os != "os2")
		{
		

		add_obj("system = '" ~ target_os ~ "'"); 
		printv("sucessfully added OS: " ~ target_os);
		passedflag();


		} 

		else 

		{
			add_obj("system = 'os/2'");
			printv("sucessfully added OS: " ~ target_os );

			passedflag();
		}
	}
	else 
	{
		writeln("OS Not supported!");
		return;
	}


	if (find_e(conflib.endian, conflib.endians) != "") 
	{ 

		add_section("[host_machine]", conflib.required_sections.hostmachine);

		add_obj("endian = '" ~ conflib.endian ~ "'"); 
		printv("added endian: " ~ endian); 
		passedflag();
	} else 
	{
		writeln("endian must be either big or little");
		return;
	}



	// adding the c compiler if the user told it to add

	// Binaries
	
	//these are compilers that convert Your code to machine code so its way easier for the cpu to understand.
	//because once your code is compiled it tends to run faster than running it on a interpreter.

	if (conflib.c_compiler != "") 
	{ 
		add_section("[binaries]", conflib.required_sections.binaries);

		if (!c_compiler.canFind("[")) 
		{ 
			add_obj("c = '" ~ c_compiler ~ "'");
		} 
		else 
		{
			add_obj("c = " ~ c_compiler);
		} 
			printv("added C Compiler: " ~ c_compiler); 
			passedflag();
	}


	// find the [ to identify if its a array if it does have then dont quote it if it doesnt have quote it!

	if (conflib.d_compiler != "") //d binaries
	{ 
		add_section("[binaries]", conflib.required_sections.binaries);

		if (!d_compiler.canFind("[")) 
		{ 
			add_obj("d = '" ~ conflib.d_compiler ~ "'");
		} 
			printv("added D Compiler: " ~ conflib.d_compiler); 
			passedflag();

		} 


	if (conflib.cpp_compiler != "") //cpp binaries
	{ 
		add_section("[binaries]", conflib.required_sections.binaries);

		if (!cpp_compiler.canFind("[")) 
		{ 
			add_obj("cpp = '" ~ cpp_compiler ~ "'");
		} 
		else 
		{
			add_obj("cpp = " ~ cpp_compiler);
		} 
			printv("added C++ Compiler: " ~ cpp_compiler); 
			passedflag();
	}

	//C#, Rust, and fortran support is finally here

	if (conflib.rust_compiler != "") 
	{
		add_section("[binaries]", conflib.required_sections.binaries);

		if (!rust_compiler.canFind("[")) 
		{ 
			add_obj("rust = '" ~ rust_compiler ~ "'");
		} 
		else 
		{
			add_obj("rust = " ~ rust_compiler);
		} 
			printv("added rust Compiler: " ~ rust_compiler); 
			passedflag();
	}

	if (conflib.cs_compiler != "") 
	{
		add_section("[binaries]", conflib.required_sections.binaries);

		if (!cs_compiler.canFind("[")) 
		{ 
			add_obj("cs = '" ~ rust_compiler ~ "'");
		} 
		else 
		{
			add_obj("cs = " ~ rust_compiler);
		} 
			printv("added C# Compiler: " ~ cs_compiler); 
			passedflag();
	}

	if (conflib.fortran_compiler != "") 
	{
		add_section("[binaries]", conflib.required_sections.binaries);

		if (!fortran_compiler.canFind("[")) 
		{ 
			add_obj("fortran = '" ~ fortran_compiler ~ "'");
		} 
		else 
		{
			add_obj("fortran = " ~ fortran_compiler);
		} 
			printv("added fortran Compiler: " ~ fortran_compiler); 
			passedflag();
	}



	// these are just binaries for meson, meson requires these (Except exe wrapper).
	// The exe wrapper is just software that runs the software from windows
	// if you are on linux the exe wrapper can get handy sometimes.


	if (conflib.ar != "") //ar binaries
	{ 
		add_section("[binaries]", conflib.required_sections.binaries);

		add_obj("ar = '" ~ conflib.ar ~ "'"); 
		printv("added ar: " ~ conflib.ar ); 
		passedflag();
	}

	if (conflib.exe_wrapper != "") 
	{
		add_section("[binaries]", conflib.required_sections.binaries);

		add_obj("exe_wrapper = '" ~ conflib.exe_wrapper ~ "'");
		printv("added exe wrapper: " ~ conflib.exe_wrapper,  );
		passedflag();
	}



	if (conflib.windres != "") //windres binaries
	{ 
		add_section("[binaries]", conflib.required_sections.binaries);

		add_obj("windres = '" ~ conflib.windres ~ "'"); 
		printv("added windres: " ~ conflib.windres ); 
		passedflag(); 
	}


	if (conflib.strip != "") //strip binaries
	{ 
		add_section("[binaries]", conflib.required_sections.binaries);

		add_obj("strip = '" ~ conflib.strip ~ "'");
		 printv("added strip: " ~ conflib.strip ); 
		 passedflag(); 
	}

	// Properties


	// These are rare ones they tell how many bytes a type should take.
	// These are really used for microcontrollers where storage is tight.

	if (conflib.soi != 0) 
	{ 
		add_section("[properties]", conflib.required_sections.properties);

		add_obj("sizeof_int = " ~ tostring(conflib.soi)); passedflag();
		printv("added sizeof_int: " ~ tostring(conflib.soi),  );

		passedflag(); 
	}


	if (conflib.soc != 0) 
	{ 
		add_section("[properties]", conflib.required_sections.properties);


		add_obj("sizeof_wchar_t = " ~ tostring(conflib.soc)); 
		printv("added wchar_t: " ~ tostring(conflib.soc),  );

		passedflag();
	}


	if (conflib.sov != 0) 
	{ 
		add_section("[properties]", conflib.required_sections.properties);

		add_obj("sizeof_void* = " ~ tostring(conflib.sov)); 
		printv("added sizeof_void*: " ~ tostring(conflib.sov),  );


		passedflag();

	}


	if (conflib.has_printf) 
	{ 
		add_section("[properties]", conflib.required_sections.properties);

		add_obj("has_function_printf = "~ bool_to_str(conflib.has_printf)); 
		printv("added has_function_printf*: " ~ bool_to_str(conflib.has_printf),  );


		passedflag();

	}


	// Needs exe wrapper tells meson if the app requires a wrapper like wine.
	// Its most likely for testing purposes.

	if (conflib.needs_exe_wrap) 
	{
	add_section("[properties]", conflib.required_sections.properties);


	add_obj("needs_exe_wrapper = " ~ bool_to_str(needs_exe_wrap)); 
	printv("need EXE Wrapper: " ~ conflib.needs_exe_wrap,  );

	passedflag();

	}


	if (conflib.pkg_conf != "") 
	{ 
	add_section("[properties]", conflib.required_sections.properties);

	add_obj("pkg_config_libdir = '" ~ pkg_conf ~ "'");
	crosslib.printv("added pkg_confing_libdir: " ~ conflib.pkg_conf,  );

    passedflag();
	}


	if (conflib.sys_root != "") 
	{ 
	add_section("[properties]", conflib.required_sections.properties);

	add_obj("sys_root = '" ~ conflib.sys_root ~ "'"); 

	crosslib.printv("added sys_root: " ~ conflib.sys_root,  );
	passedflag();
	}
	
	// these are custom stdlibs that the user can define.
	// Custom STD Libs are rarely ever used though so i added this so if
	// The user has a custom stdlib they can just add it here.

	if (conflib.cstdlib.length > 0) 
	{
		add_section("[properties]", conflib.required_sections.properties);

		add_obj("c_stdlib = " ~ crosslib.arrtostr(conflib.cstdlib));

		crosslib.printv("added d_std_lib: " ~ crosslib.arrtostr(conflib.cstdlib));
	}


	if (conflib.cppstdlib.length > 0)
	{
		add_section("[properties]", conflib.required_sections.properties);

		add_obj("cpp_stdlib = " ~ crosslib.arrtostr(conflib.cppstdlib));

		crosslib.printv("added cpp_std_lib: " ~ crosslib.arrtostr(conflib.cppstdlib));
	}

	



	// Language arguments
	//These add a section just like linker arguments it converts a array into single quoted ones because
	//Apparently double quoted strings in a crossfile makes meson error out



	if (conflib.da.length > 0) 
	{
		add_section("[built-in options]", conflib.required_sections.builtin);

		add_obj("d_args = " ~ crosslib.arrtostr(conflib.da));
		printv("added d_args: "~  crosslib.arrtostr(conflib.da));

		passedflag();
	} 


	if (conflib.ca.length > 0) 
	{
		add_section("[built-in options]", conflib.required_sections.builtin);

		add_obj("c_args = " ~ crosslib.arrtostr(conflib.ca));
		printv("added c_args: "~ crosslib.arrtostr(conflib.ca));

		passedflag();
	} 


	if (conflib.cppa.length > 0) 
	{
		add_section("[built-in options]", conflib.required_sections.builtin);

		add_obj("cpp_args = " ~ crosslib.arrtostr(cppa));
		printv("added cpp_args: "~  crosslib.arrtostr(cppa));

		passedflag();
	} 

	// Linker arguments for compilers

	//This section checks if there is a builtin-in options Section, and if there is it adds a array because
	// Linker arguments are arrays apparently.

	if (conflib.dla.length > 0 ) 
	{
		add_section("[built-in options]", conflib.required_sections.builtin);

		add_obj("d_link_args = " ~ crosslib.arrtostr(dla));
		printv("added d_link_args: "~ crosslib.arrtostr(dla));

		passedflag();
	} 



	if (conflib.cla.length > 0) 
	{
		add_section("[built-in options]", conflib.required_sections.builtin);

		add_obj("c_link_args = " ~ crosslib.arrtostr(conflib.cla));
		printv("added c_link_args: "~ crosslib.arrtostr(cla));

		passedflag();
	} 



	if (conflib.cppla.length > 0) 
	{
		add_section("[built-in options]", conflib.required_sections.builtin);

		add_obj("cpp_link_args = " ~ crosslib.arrtostr(cppla));
		printv("added cpp_link_args: "~ crosslib.arrtostr(cppla));

		passedflag();
	} 

	if (conflib.csla.length > 0 ) 
	{
		add_section("[built-in options]", conflib.required_sections.builtin);

		add_obj("cs_link_args = " ~ crosslib.arrtostr(csla));
		printv("added cs_link_args: "~ crosslib.arrtostr(csla));

		passedflag();
	} 

	if (conflib.rustla.length > 0 ) 
	{
		add_section("[built-in options]", conflib.required_sections.builtin);

		add_obj("rust_link_args = " ~ crosslib.arrtostr(rustla));
		printv("added rust_link_args: "~ crosslib.arrtostr(rustla));

		passedflag();
	} 

	if (conflib.fortranla.length > 0 ) 
	{
		add_section("[built-in options]", conflib.required_sections.builtin);

		add_obj("fortran_link_args = " ~ crosslib.arrtostr(fortranla));
		printv("added fortran_link_args: "~ crosslib.arrtostr(fortranla));

		passedflag();
	} 





	if (has_passedflags) 
	{
		generate_crossfile(stuffforfile,target_os);
		return;
	} 

	else 

	{
		writeln("No flags please type ./crossfile -h for help info!");
		return;
	}







	}
	catch (GetOptException e) 
	{
		
		if (args.length > 1) 

		{

		writeln("Unrecognized Argument!: " ~ args[1]);

		} 
		else 
		{

			writeln("No value for argument found!");

		}

	}


	
	
}